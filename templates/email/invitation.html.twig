{% extends 'email/layout.html.twig' %}

{% block content %}
    <p>{{ 'greeting'|trans({name: name}, 'emails') }}</p>
    <p>{{ 'invitation.intro'|trans({}, 'emails') }}</p>
    <p>{{ 'invitation.instructions'|trans({}, 'emails') }}</p>
    <p style="margin:1.5rem 0;">
        <a href="{{ url }}" style="background:#FFC857;color:#1D1A33;font-weight:700;padding:0.75rem 1.25rem;border-radius:999px;text-decoration:none;display:inline-block;">{{ 'invitation.button'|trans({}, 'emails') }}</a>
    </p>
    <p style="font-size:0.9rem;color:#B9B0D0;">{{ 'invitation.expiry'|trans({expiresAt: expiresAt|date('expiry_format'|trans({}, 'emails'), timezone)}, 'emails') }}</p>
{% endblock %}
