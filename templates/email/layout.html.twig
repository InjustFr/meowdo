<!DOCTYPE html>
<html lang="{{ locale }}">
<body style="margin:0;padding:2rem;background:#f5f5f3;font-family:'Atkinson Hyperlegible Next',Arial,sans-serif;color:#2b2b28;">
    <div style="max-width:32rem;margin:0 auto;background:#ffffff;border:1px solid #e6e6e2;border-radius:8px;padding:2rem;">
        <p style="font-family:'Patua One',Rockwell,Georgia,serif;font-size:1.75rem;margin:0 0 1.5rem;color:#5b7f3a;">mossydew</p>
        {% block content %}{% endblock %}
        <p style="margin:2rem 0 0;font-size:0.8rem;color:#6f6f6b;">
            {{ 'layout.copy_link'|trans({}, 'emails') }}<br>
            <a href="{{ url }}" style="color:#5b7f3a;word-break:break-all;">{{ url }}</a>
        </p>
    </div>
</body>
</html>
