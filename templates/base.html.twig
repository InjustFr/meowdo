<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-theme="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="theme-color" content="#1D1A33">
        <meta name="color-scheme" content="dark">
        <title>{% block title %}Meowdo{% endblock %}</title>
        <link rel="icon" type="image/svg+xml" href="/icons/meowdo.svg">
        <link rel="manifest" href="/manifest.webmanifest">
        <link rel="apple-touch-icon" href="/icons/meowdo-192.png">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body data-locale="{{ app.request.locale }}">
        {% block body %}{% endblock %}
    </body>
</html>
